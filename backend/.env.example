APP_NAME="GS Luxury"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# URL storefront Next.js (dùng cho link giới thiệu CTV & CORS)
FRONTEND_URL=http://localhost:3000

# --- Database (MySQL qua XAMPP) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gs_luxury
DB_USERNAME=root
DB_PASSWORD=

# Không có MySQL? Dùng SQLite: bỏ 6 dòng DB_* ở trên, thay bằng
#   DB_CONNECTION=sqlite
# rồi tạo file rỗng database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Email xác nhận đơn hàng: "log" ghi vào storage/logs khi chạy local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@gsluxury.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Tùy chọn: chỉ cần khi test các tích hợp thật ---
# MoMo sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/order-success
MOMO_IPN_URL=

# VNPAY sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/order-success
VNPAY_IPN_URL=

# Giao Hàng Nhanh (không có thì dùng phí ship mặc định)
GHN_TOKEN=
GHN_SHOP_ID=
GHN_ENDPOINT=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=

# Google Gemini (AI Concierge / Stylist)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
